# Database (local Docker, or Neon connection string in prod)
DATABASE_URL=postgresql://seen:seen_secret@localhost:5432/seen_jeem?schema=public

# API
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGIN=http://localhost:3000
# Public URL of the API (Render URL in prod). Used for /media and /uploads links.
API_PUBLIC_URL=http://localhost:4000
ADMIN_EMAIL=admin@seenjeem.local
ADMIN_PASSWORD=admin123456

# Storage: auto | minio | local | db
# Use `db` on free Render+Neon (no MinIO). Seeded covers live in apps/web/public/uploads.
STORAGE_MODE=auto

# MinIO / S3 (local docker only; leave unset in free prod)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=seen-media
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000/seen-media

# Web (Vercel: set these to your Render API URL)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
